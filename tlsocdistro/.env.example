# ---- TLSOC distribution (OpenSearch edition) ----
# Copy to .env (install.sh does this for you) and set the values.

# Component versions (match the tested combo: OpenSearch 3.7 + TLSOC Dashboards 3.8)
OPENSEARCH_VERSION=3.7.0
KAFKA_VERSION=4.0.0
LOGSTASH_VERSION=8.9.0

# The TLSOC Dashboards image tag you built with ./dashboards/build-image.sh
TLSOC_DASHBOARDS_IMAGE=tlsoc-dashboards:1.0

# Credentials — CHANGE THESE. OPENSEARCH_ADMIN_PASSWORD must satisfy OpenSearch's password policy
# (>=8 chars, upper, lower, digit, special).
OPENSEARCH_ADMIN_PASSWORD=ChangeMe#Admin2026!

# Resources / ports
OPENSEARCH_HEAP=1g
DASHBOARDS_PORT=5601

# Where the FOSS SOC Engine writes its ECS output on THIS host (Logstash mounts it read-only).
# Matches the engine's config.yaml `paths.output_dir`.
PARSER_OUTPUT_DIR=/var/log/soc_output

# This machine's LAN IP — endpoints forward their logs to <HOST_IP>:9094. install.sh auto-detects it.
HOST_IP=<IP_OF_THIS_MACHINE>
