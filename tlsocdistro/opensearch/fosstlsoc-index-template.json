{
  "index_patterns": [
    "fosstlsoc-logs-*",
    "all-logs-*",
    "soc-*"
  ],
  "priority": 500,
  "_meta": {
    "description": "TLSOC log index template \u2014 ECS types for the FOSS SOC Engine output (regenerated from soc-index-template.json)."
